# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERPAPI_API_KEY: API key for SerpApi Google Jobs API (https://serpapi.com/google-jobs-api)
# Enables Google Jobs aggregation across LinkedIn, Indeed, Naukri, Glassdoor, Foundit, and company career pages.
SERPAPI_API_KEY=""

# ADZUNA_APP_ID & ADZUNA_APP_KEY: Optional API credentials for Adzuna India Jobs API
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# SESSION_SECRET: Secret used to sign email/password user session tokens
SESSION_SECRET="change-this-in-production-to-a-long-random-string"

# ADMIN_EMAILS: Comma-separated list of administrator email addresses
ADMIN_EMAILS="luckymurthu@gmail.com"
